# Project Configurations
PROJECT_NAME="GAURDIAN AI Guardian"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security & JWT
# Generate a secret key in production using: openssl rand -hex 32
JWT_SECRET=8f4a13f7dc53b6d4fe9f029b3c4f74dbe5f75bbcd7b9c9f28df95c256a42217c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In docker-compose, postgres host is 'db'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gaurdiandb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gaurdiandb
POSTGRES_PORT=5432

# Cache & In-Memory Storage
# In docker-compose, redis host is 'redis'
REDIS_URL=redis://localhost:6379/0

# Optional AI services or mock settings
MOCK_AI_MODEL=true
CLAUDE_API_KEY=mock-key
